@model Ecommerce.Core.Entities.Address

@{
    ViewData["Title"] = "Address Details";
}

<div class="container my-4">
    <h2 class="mb-3">Address Details</h2>
    <hr />

    <dl class="row">

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.Title)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.City)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.City)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.District)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.District)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.OpenAddress)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.OpenAddress)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.IsActive)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.IsActive)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.IsBillingAddress)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.IsBillingAddress)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.IsDeliveryAddress)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.IsDeliveryAddress)
        </dd>

        <dt class="col-sm-3">
            User
        </dt>
        <dd class="col-sm-9">
            @Model.AppUser?.Name @Model.AppUser?.Surname
        </dd>

    </dl>

    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">
            Edit
        </a>

        <a asp-action="Index" class="btn btn-secondary">
            Back to List
        </a>
    </div>
</div>