@model Ecommerce.Core.Entities.AppUser

@{
    ViewData["Title"] = "Delete User";
}

<h3>Are you sure you want to delete this user?</h3>

<div>
    <hr />

    <dl class="row">

        <dt class="col-md-3">@Html.DisplayNameFor(m => m.Name)</dt>
        <dd class="col-md-9">@Html.DisplayFor(m => m.Name)</dd>

        <dt class="col-md-3">@Html.DisplayNameFor(m => m.Surname)</dt>
        <dd class="col-md-9">@Html.DisplayFor(m => m.Surname)</dd>

        <dt class="col-md-3">@Html.DisplayNameFor(m => m.Email)</dt>
        <dd class="col-md-9">@Html.DisplayFor(m => m.Email)</dd>

        <dt class="col-md-3">@Html.DisplayNameFor(m => m.Phone)</dt>
        <dd class="col-md-9">@Html.DisplayFor(m => m.Phone)</dd>

        <dt class="col-md-3">@Html.DisplayNameFor(m => m.UserName)</dt>
        <dd class="col-md-9">@Html.DisplayFor(m => m.UserName)</dd>

        <dt class="col-md-3">@Html.DisplayNameFor(m => m.IsActive)</dt>
        <dd class="col-md-9">@Html.DisplayFor(m => m.IsActive)</dd>

        <dt class="col-md-3">@Html.DisplayNameFor(m => m.IsAdmin)</dt>
        <dd class="col-md-9">@Html.DisplayFor(m => m.IsAdmin)</dd>

        <dt class="col-md-3">@Html.DisplayNameFor(m => m.CreateDate)</dt>
        <dd class="col-md-9">@Html.DisplayFor(m => m.CreateDate)</dd>

    </dl>

    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <input type="submit" value="Delete" class="btn btn-danger" />
        |
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>