@model Ecommerce.Core.Entities.Category

@{
    ViewData["Title"] = "Delete A Category";
}

<h3>Are you sure you want to delete this Category?</h3>
<div>
    <h4>Category</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Name)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(m => m.Name)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Description)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(m => m.Description)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Image)</dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.Image))
            {
                <img src="/Img/Categories/@Model.Image" height="75" />
            }
            else
            {
                <span>No Image</span>
            }
        </dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.IsActive)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(m => m.IsActive)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.IsTopMenu)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(m => m.IsTopMenu)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.ParentId)</dt> 
        <dd class="col-sm-10">@Html.DisplayFor(m => m.ParentId)</dd>

        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.OrderNo)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(m => m.OrderNo)</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>