@model Ecommerce.Core.Entities.Coupon

@{
    ViewData["Title"] = "Coupon Details";
}

<div>
    <hr />

    <dl class="row">

        <!-- CODE -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Code)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Code)
        </dd>

        <!-- DISCOUNT -->
        <dt class="col-sm-2">
            Discount %
        </dt>
        <dd class="col-sm-10">
            @Model.DiscountPercent %
        </dd>

        <!-- START DATE -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.StartDate)
        </dt>
        <dd class="col-sm-10">
            @Model.StartDate.ToString("dd.MM.yyyy HH:mm")
        </dd>

        <!-- END DATE -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.EndDate)
        </dt>
        <dd class="col-sm-10">
            @Model.EndDate.ToString("dd.MM.yyyy HH:mm")
        </dd>

        <!-- USAGE LIMIT -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.UsageLimit)
        </dt>
        <dd class="col-sm-10">
            @(Model.UsageLimit.HasValue? Model.UsageLimit.ToString() : "Unlimited")
        </dd>

        <!-- USED COUNT -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.UsedCount)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.UsedCount)
        </dd>

        <!-- STATUS -->
        <dt class="col-sm-2">
            Status
        </dt>
        <dd class="col-sm-10">
            @(Model.IsActive ? "Active" : "Inactive")
        </dd>

        <!-- CREATED DATE -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CreateDate)
        </dt>
        <dd class="col-sm-10">
            @Model.CreateDate.ToString("dd.MM.yyyy HH:mm")
        </dd>

    </dl>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>