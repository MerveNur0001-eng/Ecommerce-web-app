@model IEnumerable<Ecommerce.Core.Entities.Coupon>

@{
    ViewData["Title"] = "Coupons";
}

<p>
    <a asp-action="Create" class="btn btn-outline-primary">
        <i class="fa-solid fa-plus"></i> Add New Coupon
    </a>
</p>

<table class="table table-hover table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Code)
            </th>

            <th>
                Discount %
            </th>

            <th>
                Start Date
            </th>

            <th>
                End Date
            </th>

            <th>
                Usage
            </th>

            <th>
                @Html.DisplayNameFor(model => model.IsActive)
            </th>

            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>

                <!-- CODE -->
                <td>
                    @Html.DisplayFor(modelItem => item.Code)
                </td>

                <!-- DISCOUNT -->
                <td>
                    @item.DiscountPercent %
                </td>

                <!-- START DATE -->
                <td>
                    @item.StartDate.ToString("dd.MM.yyyy")
                </td>

                <!-- END DATE -->
                <td>
                    @item.EndDate.ToString("dd.MM.yyyy")
                </td>

                <!-- USAGE -->
                <td>
                    @item.UsedCount
                    @if (item.UsageLimit.HasValue)
                    {
                        <span> / @item.UsageLimit</span>
                    }
                    else
                    {
                        <span> / ∞</span>
                    }
                </td>

                <!-- STATUS -->
                <td>
                    @if (item.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </td>

                <!-- ACTIONS -->
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>

            </tr>
        }
    </tbody>
</table>