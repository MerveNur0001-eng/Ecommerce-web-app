@model Ecommerce.Core.Entities.Order

@{
    ViewData["Title"] = "Delete Order";
}

<h3>Are you sure you want to delete this?</h3>

<div>
    <hr />

    <dl class="row">

        <!-- ORDER NUMBER -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.OrderNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.OrderNumber)
        </dd>

        <!-- TOTAL PRICE -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TotalPrice)
        </dt>
        <dd class="col-sm-10">
            @("$" + Model.TotalPrice.ToString("0.00"))
        </dd>

        <!-- USER ID -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.AppUserId)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AppUserId)
        </dd>

        <!-- CUSTOMER -->
        <dt class="col-sm-2">
            Customer
        </dt>
        <dd class="col-sm-10">
            @(Model.AppUser?.Name + " " + Model.AppUser?.Surname)
        </dd>

        <!-- BILLING -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.BillingAddress)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.BillingAddress)
        </dd>

        <!-- DELIVERY -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DeliveryAddress)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DeliveryAddress)
        </dd>

        <!-- ORDER DATE -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.OrderDate)
        </dt>
        <dd class="col-sm-10">
            @Model.OrderDate.ToString("dd.MM.yyyy HH:mm")
        </dd>

        <!-- ORDER STATE -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.OrderState)
        </dt>
        <dd class="col-sm-10">
            @Model.OrderState
        </dd>

    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />

        <input type="submit" value="Delete" class="btn btn-danger" />

        |
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>