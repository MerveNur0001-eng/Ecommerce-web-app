@model Ecommerce.Core.Entities.Order

@using System.ComponentModel.DataAnnotations
@using System.Reflection

@{
    ViewData["Title"] = "Order Details";
}

@functions {
    public string GetEnumDisplayName(Enum value)
    {
        var field = value.GetType().GetField(value.ToString());
        var attr = field?.GetCustomAttribute<DisplayAttribute>();
        return attr?.Name ?? value.ToString();
    }
}

<div>
    <hr />

    <dl class="row">

        <!-- ORDER NUMBER -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.OrderNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.OrderNumber)
        </dd>

        <!-- TOTAL PRICE -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.TotalPrice)
        </dt>
        <dd class="col-sm-10">
            @("$" + Model.TotalPrice.ToString("0.00"))
        </dd>

        <!-- USER ID -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.AppUserId)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.AppUserId)
        </dd>

        <!-- CUSTOMER -->
        <dt class="col-sm-2">
            Customer
        </dt>
        <dd class="col-sm-10">
            @(Model.AppUser?.Name + " " + Model.AppUser?.Surname)
        </dd>

        <!-- BILLING ADDRESS -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.BillingAddress)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.BillingAddress)
        </dd>

        <!-- DELIVERY ADDRESS -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DeliveryAddress)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DeliveryAddress)
        </dd>

        <!-- ORDER DATE -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.OrderDate)
        </dt>
        <dd class="col-sm-10">
            @Model.OrderDate.ToString("dd.MM.yyyy HH:mm")
        </dd>

        <!-- ORDER STATE (FIXED) -->
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.OrderState)
        </dt>
        <dd class="col-sm-10">
            @GetEnumDisplayName(Model.OrderState)
        </dd>

    </dl>

    <!-- ORDER LINES -->
    @if (Model.OrderLines != null && Model.OrderLines.Any())
    {
        decimal grandTotal = 0;

        <table class="table table-sm table-hover align-middle">

            <thead>
                <tr>
                    <th></th>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Qty</th>
                    <th>Total</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.OrderLines)
                {
                    var lineTotal = item.UnitPrice * item.Quantity;
                    grandTotal += lineTotal;

                    <tr>

                        <!-- PRODUCT IMAGE -->
                        <td style="width:80px;">
                            <img src="/Img/Products/@item.Product?.Image"
                                 alt="@item.Product?.Name"
                                 class="rounded"
                                 style="height:50px; width:50px; object-fit:cover;" />
                        </td>

                        <td class="fw-semibold">
                            @item.Product?.Name
                        </td>

                        <td>
                            @("$" + item.UnitPrice.ToString("0.00"))
                        </td>

                        <td>
                            @item.Quantity
                        </td>

                        <td class="fw-bold">
                            @("$" + lineTotal.ToString("0.00"))
                        </td>

                    </tr>
                }
            </tbody>

            <tfoot>
                <tr>
                    <td colspan="4" class="text-end fw-bold">
                        Grand Total:
                    </td>
                    <td class="fw-bold text-success fs-5">
                        @("$" + grandTotal.ToString("0.00"))
                    </td>
                </tr>
            </tfoot>

        </table>
    }
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</div>