@model Ecommerce.Core.Entities.ProductImage

@{
    ViewData["Title"] = "Edit Product Image";
}

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-2">
                <img src="/Img/Products/@Model.Name" height="60" />
            </div>

            <div class="form-group">
                <label>Change Image</label>
                <input name="Name" class="form-control" type="file" />
            </div>

            <div class="form-group mt-2">
                <label asp-for="Description"></label>
                <input asp-for="Description" class="form-control" />
            </div>

            <div class="form-group mt-2">
                <label asp-for="ProductId"></label>
                <select asp-for="ProductId" class="form-select" asp-items="ViewBag.ProductId"></select>
            </div>

            <div class="form-group mt-3">
                <input type="submit" value="Update" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back</a>
            </div>
        </form>
    </div>
</div>