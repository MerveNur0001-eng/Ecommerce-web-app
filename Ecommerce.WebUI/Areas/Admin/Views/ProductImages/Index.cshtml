@model IEnumerable<Ecommerce.Core.Entities.ProductImage>

@{
    ViewData["Title"] = "Product Images";
}

<p>
    <a asp-action="Create" class="btn btn-outline-primary">
        <i class="fa-solid fa-plus"></i> Add New
    </a>
</p>

<table class="table table-bordered table-hover" id="datatablesSimple">
    <thead>
        <tr>
            <th>Image</th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Product)
            </th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>

                <!-- IMAGE -->
                <td>
                    @if (!string.IsNullOrEmpty(item.Name))
                    {
                        <a href="~/Img/Products/@item.Name" target="_blank">
                            <img src="~/Img/Products/@item.Name"
                                 alt="product image"
                                 height="40"
                                 asp-append-version="true" />
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">No Image</span>
                    }
                </td>

                <!-- DESCRIPTION -->
                <td>
                    @item.Description
                </td>

                <!-- PRODUCT NAME -->
                <td>
                    @item.Product?.Name
                </td>

                <!-- ACTIONS -->
                <td>
                    <a class="btn btn-sm btn-primary"
                       asp-action="Edit"
                       asp-route-id="@item.Id">
                        <i class="fa-solid fa-pen"></i>
                    </a>

                    <a class="btn btn-sm btn-info"
                       asp-action="Details"
                       asp-route-id="@item.Id">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </a>

                    <a class="btn btn-sm btn-danger"
                       asp-action="Delete"
                       asp-route-id="@item.Id">
                        <i class="fa-solid fa-trash"></i>
                    </a>
                </td>

            </tr>
        }
    </tbody>
</table>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/simple-datatables@7.1.2/dist/umd/simple-datatables.min.js"></script>

    <script>
        window.addEventListener('DOMContentLoaded', event => {

            const table = document.getElementById('datatablesSimple');

            if (table) {
                new simpleDatatables.DataTable(table, {
                    searchable: true,
                    sortable: true,
                    perPage: 10,
                    perPageSelect: [5, 10, 15, 20, 50],
                    labels: {
                        placeholder: "Search...",
                        noRows: "No data found",
                        info: "Showing {start} to {end} of {rows} entries"
                    }
                });
            }

        });
    </script>

}