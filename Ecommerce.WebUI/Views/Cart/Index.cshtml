@model CartViewModel

@{
    ViewData["Title"] = "My Cart";
}

<section class="container my-5">
    <div class="text-center">
        <h1 class="display-4">My Cart</h1>
    </div>

    <div class="row">
        @if (Model.CartLines.Any())
        {
            <div class="col-md-8">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Product</th>
                                <th>Price</th>
                                <th class="text-center">Quantity</th>
                                <th>Total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.CartLines)
                            {
                                <tr>
                                    <td>
                                        <img src="/Img/Products/@item.Product.Image"
                                             alt="@item.Product.Name"
                                             height="40" />
                                    </td>
                                    <td>
                                        <a class="nav-link text-dark p-0"
                                           href="/Products/Details/@item.Product.Id">
                                            @item.Product.Name
                                        </a>
                                    </td>
                                    <td>@item.Product.Price.ToString("c")</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td>@((item.Quantity * item.Product.Price).ToString("c"))</td>
                                    <td class="text-end">
                                        <form asp-action="Remove" asp-controller="Cart" method="post">
                                            <input type="hidden" name="ProductId" value="@item.Product.Id" />
                                            <button class="btn btn-sm btn-outline-danger" type="submit">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-light shadow-sm">
                <div class="card-body">
                    <h4 class="card-title mb-4">Cart Summary</h4>
                    <table class="table table-borderless">
                        <tbody>
                            <tr>
                                <td>Subtotal</td>
                                <td class="text-end">@Model.TotalPrice.ToString("c")</td>
                            </tr>
                            <tr>
                                <td>Shipping</td>
                                <td class="text-end text-muted">
                                    @(Model.TotalPrice > 999 ? "Free" : "99₺")
                                </td>
                            </tr>
                            <tr class="border-top">
                                <th class="pt-3">Order Total</th>
                                <td class="text-end pt-3 fw-bold text-primary">
                                    @(Model.TotalPrice > 999
                                                                        ? Model.TotalPrice.ToString("c")
                                                                        : (Model.TotalPrice + 99).ToString("c"))
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="text-center">
                    <a href="/" class="btn btn-danger">
                        <i class="bi bi-cart me-1"></i> Continue Shopping
                    </a>
                    <a href="/Cart/Checkout" class="btn btn-success">
                        <i class="bi bi-credit-card me-1"></i> Buy
                    </a>
                </div>
                   
                </div>
            </div>
        </div>
                }
        else
        {
            <div class="container">
                <div class="alert alert-warning my-5 text-center">
                    <h3>Your cart is empty!</h3>
                </div>
            </div>
        }
    </div>
</section>