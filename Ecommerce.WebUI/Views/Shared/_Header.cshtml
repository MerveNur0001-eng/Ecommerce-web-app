@using Ecommerce.Core.Entities
@using Ecommerce.WebUI.ExtensionMethods
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">AllShop</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-evenly">
                <form action="/Products" class="col-12 col-lg-auto mb-3 mb-lg-0 me-lg-3" role="search">
                    <input name="q" type="search" class="form-control" placeholder="Product search" aria-label="Search">
                </form>
                <ul class="navbar-nav m-auto">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
					@await Component.InvokeAsync("Categories")
                   
                </ul>


                @if (Context.User.Identity.IsAuthenticated)
                {
                    <div class="dropdown">
                        <a class="dropdown-toggle nav-link text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                           <i class="bi bi-person-fill"></i> My Account
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/Account/">User Information</a></li>
                            <li><a class="dropdown-item" href="/MyAddresses/">My Addresses</a></li>

                            <li><a class="dropdown-item" href="/Account/MyOrders">Orders</a></li>
                            <li><a class="dropdown-item" href="/Account/">Reviews</a></li>
                            <li class="text-center">
                                <a class="btn btn-danger" href="/Account/SignOut">
                                    Logout
                                </a>
                            </li>                        </ul>
                                                </div>
                }
                else
                {
                    <div class="dropdown">
                        <a class="dropdown-toggle nav-link text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            
                        <i class="bi bi-person"></i> Login
                        </a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/Account/SignIn">Sign In</a></li>
                            <li><a class="dropdown-item" href="/Account/SignUp">Sign Up</a></li>
                        </ul>
                    </div>
                }
                <div class="dropdown mx-3">
                    <a class="nav-link text-dark" href="/Favorites">
                        @{
                        var favorites = Context.Session.GetJson<List<Product>>("GetFavorites");
                        if (favorites is not null && favorites.Count > 0)
                        {
                            <i class="bi bi-heart-fill"></i> @:My Favorites (@favorites.Count)
                        }
                        else
                        {
                            <i class="bi bi-heart"></i> @:My Favorites
                        }
                    }
                    </a>
                   
                </div>
                <div class="dropdown me-3">
                    @{
                        var cart = Context.Session.GetJson<Ecommerce.Service.Concrete.CartService>("Cart");
                        if (cart != null && cart.CartLines.Count > 0)
                        {
                            <a class="dropdown-toggle nav-link text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-cart-fill"></i> My Cart
                                <span class="badge bg-danger text-white ms-1 rounded-pill">
									@cart.CartLines.Count
                                </span>
                            </a>
                            <ul class="dropdown-menu">
                                @foreach (var item in cart.CartLines)
                                {
                                    <li>
                                        <a class="dropdown-item" href="/Products/Details/@item.Product.Id">
                                            <img src="/Img/Products/@item.Product.Image" alt="" height="40" />
                                            @item.Product.Name
                                        </a>
                                    </li>
                                }
                                <li class="px-3 py-2">
                                    <a class="btn btn-success w-100 d-flex align-items-center justify-content-center gap-2 shadow-sm rounded-3"
                                       href="/Cart">
                                        <i class="bi bi-cart-check"></i>
                                        Go to Cart
                                    </a>
                                </li>
                            </ul>
                        }
                        else
                        {
                            <a class="nav-link text-dark" href="/Cart">
                               <i class="bi bi-cart"></i> My Cart
                            </a>
                        }
                    }
                </div>
                    <a class="nav-link text-dark" asp-controller="Home" asp-action="ContactUs">Contact</a>
            </div>
        </div>
    </nav>
</header>